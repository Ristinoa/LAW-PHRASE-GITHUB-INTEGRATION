# game/script.rpy:68
translate german opening_doorway_d37e6200:

    # narrator "You awaken on the cold stone floor. Your head throbs, and a pale, dim light illuminates the massive wooden archway before you."
    narrator "Du erwachst auf dem kalten Steinboden.“ Dein Kopf pocht, und ein fahles, schwaches Licht erhellt den massiven Holzbogen vor dir."

# game/script.rpy:73
translate german opening_doorway_d96a6d24:

    # narrator "Footsteps echo from the darkness. A figure steps into the faint light."
    narrator "Schritte hallen aus der Dunkelheit wider.“ Eine Gestalt tritt ins schwache Licht."

# game/script.rpy:79
translate german opening_doorway_7d90fa91:

    # acolyte "The stars align, seeker. The King in Yellow awaits you inside."
    acolyte "Die Sterne stehen günstig, Sucher.“ Der König in Gelb erwartet euch im Inneren."

# game/script.rpy:81
translate german opening_doorway_6de0ff8a:

    # narrator "The figure gestures toward the ornate doorway, then vanishes into the dark library corridor, leaving you alone."
    narrator "Die Gestalt deutet auf den reich verzierten Türrahmen und verschwindet dann im dunklen Bibliothekskorridor, sodass du allein zurückbleibst."

# game/script.rpy:104
translate german king_in_yellow_encounter_831388b1:

    # narrator "The shadows stretch in the damp, decaying library. The Pallid Mask sits upon a velvet cushion, its hollow eyes fixed upon you."
    narrator "Die Schatten dehnen sich in der feuchten, verfallenden Bibliothek aus.“ Die bleiche Maske ruht auf einem Samtkissen, ihre hohlen Augen auf dich gerichtet."

# game/script.rpy:112
translate german king_in_yellow_encounter_b8cdb3a0:

    # koy "You stand before the throne of Carcosa, [player_name]. You have trespassed into the halls of the unmaking."
    koy "Du stehst vor dem Thron von Carcosa, [Spielername]. Du hast die Hallen des Untergangs betreten."

# game/script.rpy:113
translate german king_in_yellow_encounter_81376e5e:

    # koy "Speak your truth before the curtain falls. Why should I remain in the shadows of the slumbering lake?"
    koy "Sprich deine Wahrheit, bevor der Vorhang fällt.\" Warum sollte ich im Schatten des schlafenden Sees verharren?"

# game/script.rpy:130
translate german lie_one_0ea0edba:

    # player "I possess the true text of the play, and I will burn it if you sleep."
    player "Ich besitze den wahren Text des Stücks, und ich werde ihn verbrennen, wenn du schläfst."

# game/script.rpy:132
translate german lie_one_0dd8e7eb:

    # koy "A lie... woven of paper and ink. You think you can destroy that which has no beginning or end?"
    koy "Eine Lüge... gewoben aus Papier und Tinte.“ Du glaubst, du kannst etwas zerstören, das keinen Anfang und kein Ende hat?"

# game/script.rpy:133
translate german lie_one_8147c7a8:

    # koy "The mask falls. The curtain rises."
    koy "Die Maske fällt.“ Der Vorhang hebt sich."

# game/script.rpy:141
translate german lie_two_47fcb90a:

    # player "The stars are not yet right, your majesty; your slumber is but an echo of a cosmic prophecy."
    player "»Die Sterne stehen noch nicht richtig, Eure Majestät; Euer Schlaf ist nur ein Echo einer kosmischen Prophezeiung.«"

# game/script.rpy:143
translate german lie_two_32af76d8:

    # koy "You dare lecture me on the alignment of the cosmos, little insect?"
    koy "Du wagst es, mir etwas über die Ausrichtung des Kosmos zu erzählen, du kleines Insekt?"

# game/script.rpy:144
translate german lie_two_7b1addbd:

    # koy "I am the cosmos. The stars align only when I draw breath."
    koy "Ich bin der Kosmos.“ Die Sterne stehen nur dann günstig, wenn ich atme."

# game/script.rpy:152
translate german lie_three_0acec964:

    # player "I have hidden the Yellow Sign where no human eye will ever find it, ensuring eternal worship in your absence."
    player "Ich habe das gelbe Zeichen an einem Ort versteckt, wo es kein menschliches Auge jemals finden wird, um die ewige Verehrung auch in deiner Abwesenheit zu gewährleisten."

# game/script.rpy:154
translate german lie_three_b63505d0:

    # koy "Ah... an offering of devotion disguised as a threat."
    koy "Ah… ein als Drohung getarntes Opfer der Hingabe."

# game/script.rpy:155
translate german lie_three_27d264ac:

    # koy "To hoard the symbol of our glory so that none may gaze upon it."
    koy "Das Symbol unseres Ruhms zu horten, damit es niemand erblicke."

# game/script.rpy:157
translate german lie_three_6fde25c3:

    # narrator "The entity's glowing eyes soften. A deep, heavy sigh echoes through the room."
    narrator "Die leuchtenden Augen des Wesens werden weicher.“ Ein tiefer, schwerer Seufzer hallt durch den Raum."

# game/script.rpy:161
translate german lie_three_9f40032f:

    # koy "Very well, mortal. Keep the Sign safe, and I shall dream of Carcosa's return for a thousand years more."
    koy "Sehr wohl, Sterblicher.“ Bewahrt das Zeichen sicher auf, und ich werde noch tausend Jahre lang von Carcosas Rückkehr träumen."

# game/script.rpy:165
translate german lie_three_bae86f9a:

    # narrator "The eldritch presence fades into a deep, heavy slumber. The room returns to normal."
    narrator "Die unheimliche Präsenz gleitet in einen tiefen, schweren Schlaf.“ Der Raum kehrt in seinen Normalzustand zurück."

# game/script.rpy:175
translate german lie_three_0b914413:

    # narrator "You have saved humanity from the King in Yellow... for now."
    narrator "Du hast die Menschheit vor dem König in Gelb gerettet … vorerst."

# game/script.rpy:183
translate german game_over_awakened_57fc504f:

    # koy "Carcosa awakens."
    koy "Carcosa erwacht."

# game/script.rpy:197
translate german game_over_awakened_b04ced02:

    # narrator "The barrier between worlds shatters. The corruption bleeds into your operating system."
    narrator "Die Barriere zwischen den Welten zerbricht.“ Die Korruption sickert in Ihr Betriebssystem ein."

# game/script.rpy:198
translate german game_over_awakened_3f9d77c6:

    # narrator "CONNECTION TERMINATED. SYSTEM COMPROMISED.{w=0.5}.{w=0.5}."
    narrator "VERBINDUNG UNTERBROCHEN.\" SYSTEM BESCHÄDIGT.{w=0.5}.{w=0.5}."

