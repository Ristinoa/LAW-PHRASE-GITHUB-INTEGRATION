# game/script.rpy:68
translate spanish opening_doorway_d37e6200:

    # narrator "You awaken on the cold stone floor. Your head throbs, and a pale, dim light illuminates the massive wooden archway before you."
    narrator "Despiertas en el frío suelo de piedra. Te late la cabeza con fuerza, y una luz tenue y pálida ilumina el enorme arco de madera que tienes delante."

# game/script.rpy:73
translate spanish opening_doorway_d96a6d24:

    # narrator "Footsteps echo from the darkness. A figure steps into the faint light."
    narrator "Los pasos resuenan desde la oscuridad. Una figura aparece en la tenue luz."

# game/script.rpy:79
translate spanish opening_doorway_7d90fa91:

    # acolyte "The stars align, seeker. The King in Yellow awaits you inside."
    acolyte "Las estrellas se alinean, buscador. El Rey de Amarillo te espera dentro."

# game/script.rpy:81
translate spanish opening_doorway_6de0ff8a:

    # narrator "The figure gestures toward the ornate doorway, then vanishes into the dark library corridor, leaving you alone."
    narrator "La figura señala hacia la puerta ornamentada y luego desaparece en el oscuro pasillo de la biblioteca, dejándote solo."

# game/script.rpy:104
translate spanish king_in_yellow_encounter_831388b1:

    # narrator "The shadows stretch in the damp, decaying library. The Pallid Mask sits upon a velvet cushion, its hollow eyes fixed upon you."
    narrator "Las sombras se alargan en la biblioteca húmeda y en ruinas. La Máscara Pálida reposa sobre un cojín de terciopelo, con sus ojos huecos fijos en ti."

# game/script.rpy:112
translate spanish king_in_yellow_encounter_b8cdb3a0:

    # koy "You stand before the throne of Carcosa, [player_name]. You have trespassed into the halls of the unmaking."
    koy "Te encuentras ante el trono de Carcosa, [nombre_del_jugador]. Has irrumpido sin permiso en los salones de la aniquilación."

# game/script.rpy:113
translate spanish king_in_yellow_encounter_81376e5e:

    # koy "Speak your truth before the curtain falls. Why should I remain in the shadows of the slumbering lake?"
    koy "Di tu verdad antes de que caiga el telón. ¿Por qué debería permanecer en las sombras del lago dormido?"

# game/script.rpy:130
translate spanish lie_one_0ea0edba:

    # player "I possess the true text of the play, and I will burn it if you sleep."
    player "Tengo el texto auténtico de la obra, y lo quemaré si duermes."

# game/script.rpy:132
translate spanish lie_one_0dd8e7eb:

    # koy "A lie... woven of paper and ink. You think you can destroy that which has no beginning or end?"
    koy "Una mentira... tejida de papel y tinta. ¿Crees que puedes destruir aquello que no tiene principio ni fin?"

# game/script.rpy:133
translate spanish lie_one_8147c7a8:

    # koy "The mask falls. The curtain rises."
    koy "La máscara se cae. Se levanta el telón."

# game/script.rpy:141
translate spanish lie_two_47fcb90a:

    # player "The stars are not yet right, your majesty; your slumber is but an echo of a cosmic prophecy."
    player "Las estrellas aún no están alineadas, majestad; su letargo no es más que el eco de una profecía cósmica."

# game/script.rpy:143
translate spanish lie_two_32af76d8:

    # koy "You dare lecture me on the alignment of the cosmos, little insect?"
    koy "¿Te atreves a darme lecciones sobre la alineación del cosmos, pequeño insecto?"

# game/script.rpy:144
translate spanish lie_two_7b1addbd:

    # koy "I am the cosmos. The stars align only when I draw breath."
    koy "Yo soy el cosmos. Las estrellas se alinean solo cuando respiro."

# game/script.rpy:152
translate spanish lie_three_0acec964:

    # player "I have hidden the Yellow Sign where no human eye will ever find it, ensuring eternal worship in your absence."
    player "He escondido la Señal Amarilla donde ningún ojo humano la encontrará jamás, asegurando así la adoración eterna en tu ausencia."

# game/script.rpy:154
translate spanish lie_three_b63505d0:

    # koy "Ah... an offering of devotion disguised as a threat."
    koy "Ah... una ofrenda de devoción disfrazada de amenaza."

# game/script.rpy:155
translate spanish lie_three_27d264ac:

    # koy "To hoard the symbol of our glory so that none may gaze upon it."
    koy "Acaparar el símbolo de nuestra gloria para que nadie pueda contemplarlo."

# game/script.rpy:157
translate spanish lie_three_6fde25c3:

    # narrator "The entity's glowing eyes soften. A deep, heavy sigh echoes through the room."
    narrator "Los ojos brillantes de la entidad se suavizan. Un profundo y pesado suspiro resuena en la habitación."

# game/script.rpy:161
translate spanish lie_three_9f40032f:

    # koy "Very well, mortal. Keep the Sign safe, and I shall dream of Carcosa's return for a thousand years more."
    koy "Muy bien, mortal. \"Mantén el Signo a salvo, y soñaré con el regreso de Carcosa durante mil años más."

# game/script.rpy:165
translate spanish lie_three_bae86f9a:

    # narrator "The eldritch presence fades into a deep, heavy slumber. The room returns to normal."
    narrator "La presencia sobrenatural se desvanece en un sueño profundo y pesado. La habitación vuelve a la normalidad."

# game/script.rpy:175
translate spanish lie_three_0b914413:

    # narrator "You have saved humanity from the King in Yellow... for now."
    narrator "Has salvado a la humanidad del Rey de Amarillo... por ahora."

# game/script.rpy:183
translate spanish game_over_awakened_57fc504f:

    # koy "Carcosa awakens."
    koy "Carcosa despierta."

