# game/script.rpy:68
translate japanese opening_doorway_d37e6200:

    # narrator "You awaken on the cold stone floor. Your head throbs, and a pale, dim light illuminates the massive wooden archway before you."
    narrator "「あなたは冷たい石の床の上で目を覚ます。頭がズキズキと痛み、目の前の巨大な木製のアーチ道が、薄暗い淡い光に照らされている。"

# game/script.rpy:73
translate japanese opening_doorway_d96a6d24:

    # narrator "Footsteps echo from the darkness. A figure steps into the faint light."
    narrator "「暗闇から足音が響く。」一人の人物がかすかな光の中に足を踏み入れる。"

# game/script.rpy:79
translate japanese opening_doorway_7d90fa91:

    # acolyte "The stars align, seeker. The King in Yellow awaits you inside."
    acolyte "「星が揃ったぞ、探求者よ。」黄衣の王が中であなたをお待ちしています。"

# game/script.rpy:81
translate japanese opening_doorway_6de0ff8a:

    # narrator "The figure gestures toward the ornate doorway, then vanishes into the dark library corridor, leaving you alone."
    narrator "「その人物は装飾の施された戸口を指さすと、暗い図書館の廊下へと姿を消し、あなたを一人残した。」"

# game/script.rpy:104
translate japanese king_in_yellow_encounter_831388b1:

    # narrator "The shadows stretch in the damp, decaying library. The Pallid Mask sits upon a velvet cushion, its hollow eyes fixed upon you."
    narrator "「湿っぽく朽ちかけた図書館では、影が長く伸びている。」青白い仮面はベルベットのクッションの上に座り、その虚ろな目はあなたをじっと見つめている。"

# game/script.rpy:112
translate japanese king_in_yellow_encounter_b8cdb3a0:

    # koy "You stand before the throne of Carcosa, [player_name]. You have trespassed into the halls of the unmaking."
    koy "「あなたはカルコサの玉座の前に立っています、[player_name]。あなたは、崩壊の領域に足を踏み入れてしまったのです。"

# game/script.rpy:113
translate japanese king_in_yellow_encounter_81376e5e:

    # koy "Speak your truth before the curtain falls. Why should I remain in the shadows of the slumbering lake?"
    koy "「幕が下りる前に、あなたの真実を語りなさい。」なぜ私は、眠れる湖の影に留まらなければならないのだろうか？"

# game/script.rpy:130
translate japanese lie_one_0ea0edba:

    # player "I possess the true text of the play, and I will burn it if you sleep."
    player "「私はこの劇の真のテキストを所有している。もしお前が眠っているなら、それを燃やしてやる。」"

# game/script.rpy:132
translate japanese lie_one_0dd8e7eb:

    # koy "A lie... woven of paper and ink. You think you can destroy that which has no beginning or end?"
    koy "「紙とインクで織りなされた嘘。」始まりも終わりもないものを、破壊できるとでも思っているのか？"

# game/script.rpy:133
translate japanese lie_one_8147c7a8:

    # koy "The mask falls. The curtain rises."
    koy "「仮面が剥がれる。」幕が上がる。"

# game/script.rpy:141
translate japanese lie_two_47fcb90a:

    # player "The stars are not yet right, your majesty; your slumber is but an echo of a cosmic prophecy."
    player "「陛下、星々はまだ正しい位置にありません。陛下の眠りは、宇宙の予言のこだまに過ぎません。」"

# game/script.rpy:143
translate japanese lie_two_32af76d8:

    # koy "You dare lecture me on the alignment of the cosmos, little insect?"
    koy "「お前はよくも私に宇宙の配置について説教できるな、ちっぽけな虫けらめ？」"

# game/script.rpy:144
translate japanese lie_two_7b1addbd:

    # koy "I am the cosmos. The stars align only when I draw breath."
    koy "「私は宇宙です。」私が息を吸う時だけ、星々は一直線に並ぶのだ。"

# game/script.rpy:152
translate japanese lie_three_0acec964:

    # player "I have hidden the Yellow Sign where no human eye will ever find it, ensuring eternal worship in your absence."
    player "「私はあなたの不在時にも永遠の崇拝が保証されるよう、人間の目には決して見つからない場所に黄色の印を隠しました。」"

# game/script.rpy:154
translate japanese lie_three_b63505d0:

    # koy "Ah... an offering of devotion disguised as a threat."
    koy "「ああ……脅迫に偽装した献身の捧げ物か。」"

# game/script.rpy:155
translate japanese lie_three_27d264ac:

    # koy "To hoard the symbol of our glory so that none may gaze upon it."
    koy "「我々の栄光の象徴を隠し、誰もそれを見ないようにするためだ。」"

# game/script.rpy:157
translate japanese lie_three_6fde25c3:

    # narrator "The entity's glowing eyes soften. A deep, heavy sigh echoes through the room."
    narrator "「その存在の光る目が和らぐ。」深く重い溜息が部屋中に響き渡る。"

# game/script.rpy:161
translate japanese lie_three_9f40032f:

    # koy "Very well, mortal. Keep the Sign safe, and I shall dream of Carcosa's return for a thousand years more."
    koy "「よろしい、人間よ。」「あの印を守り抜いてくれれば、私はカルコサの帰還を千年もの間夢見続けるだろう。」"

# game/script.rpy:165
translate japanese lie_three_bae86f9a:

    # narrator "The eldritch presence fades into a deep, heavy slumber. The room returns to normal."
    narrator "「異様な存在は、深く重い眠りへと消えていく。」部屋は元の状態に戻った。"

# game/script.rpy:175
translate japanese lie_three_0b914413:

    # narrator "You have saved humanity from the King in Yellow... for now."
    narrator "「あなたは黄衣の王から人類を救った…今のところは。」"

# game/script.rpy:183
translate japanese game_over_awakened_57fc504f:

    # koy "Carcosa awakens."
    koy "「カルコサが目覚める。」"

# game/script.rpy:197
translate japanese game_over_awakened_b04ced02:

    # narrator "The barrier between worlds shatters. The corruption bleeds into your operating system."
    narrator "「世界間の障壁が崩れる。」腐敗はあなたのオペレーティングシステムにまで影響を及ぼすのです。"

# game/script.rpy:198
translate japanese game_over_awakened_3f9d77c6:

    # narrator "CONNECTION TERMINATED. SYSTEM COMPROMISED.{w=0.5}.{w=0.5}."
    narrator "接続が終了しました。システムが侵害されました。{w=0.5}。{w=0.5}。"

