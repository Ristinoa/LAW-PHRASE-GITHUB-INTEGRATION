# game/script.rpy:68
translate chinese opening_doorway_d37e6200:

    # narrator "You awaken on the cold stone floor. Your head throbs, and a pale, dim light illuminates the massive wooden archway before you."
    narrator "你醒来时发现自己躺在冰冷的石板地上。你头痛欲裂，眼前巨大的木制拱门被昏暗的灯光照亮。"

# game/script.rpy:73
translate chinese opening_doorway_d96a6d24:

    # narrator "Footsteps echo from the darkness. A figure steps into the faint light."
    narrator "脚步声从黑暗中回荡。一个人影走进了昏暗的光线中。"

# game/script.rpy:79
translate chinese opening_doorway_7d90fa91:

    # acolyte "The stars align, seeker. The King in Yellow awaits you inside."
    acolyte "群星连成一线，求道者。”黄衣国王在里面等着你。"

# game/script.rpy:81
translate chinese opening_doorway_6de0ff8a:

    # narrator "The figure gestures toward the ornate doorway, then vanishes into the dark library corridor, leaving you alone."
    narrator "那人影朝装饰华丽的门口做了个手势，然后消失在黑暗的图书馆走廊里，留下你独自一人。”"

# game/script.rpy:104
translate chinese king_in_yellow_encounter_831388b1:

    # narrator "The shadows stretch in the damp, decaying library. The Pallid Mask sits upon a velvet cushion, its hollow eyes fixed upon you."
    narrator "阴影在潮湿、破败的图书馆里延伸。苍白的面具放在天鹅绒垫子上，空洞的眼睛直勾勾地盯着你。"

# game/script.rpy:112
translate chinese king_in_yellow_encounter_b8cdb3a0:

    # koy "You stand before the throne of Carcosa, [player_name]. You have trespassed into the halls of the unmaking."
    koy "你站在卡尔克萨的王座前，[player_name]。”你已擅闯毁灭之殿堂。"

# game/script.rpy:113
translate chinese king_in_yellow_encounter_81376e5e:

    # koy "Speak your truth before the curtain falls. Why should I remain in the shadows of the slumbering lake?"
    koy "在帷幕落下之前，说出你的真心话。我为何要继续待在沉睡湖泊的阴影里？"

# game/script.rpy:130
translate chinese lie_one_0ea0edba:

    # player "I possess the true text of the play, and I will burn it if you sleep."
    player "我拥有该剧的真正文本，如果你睡着了，我就把它烧掉。”"

# game/script.rpy:132
translate chinese lie_one_0dd8e7eb:

    # koy "A lie... woven of paper and ink. You think you can destroy that which has no beginning or end?"
    koy "一个谎言……用纸和墨水编织而成。你以为你能摧毁一个没有开始也没有结束的东西吗？"

# game/script.rpy:133
translate chinese lie_one_8147c7a8:

    # koy "The mask falls. The curtain rises."
    koy "面具落下。”帷幕拉开。"

# game/script.rpy:141
translate chinese lie_two_47fcb90a:

    # player "The stars are not yet right, your majesty; your slumber is but an echo of a cosmic prophecy."
    player "陛下，星辰尚未归位；您的沉睡不过是宇宙预言的回响。”"

# game/script.rpy:143
translate chinese lie_two_32af76d8:

    # koy "You dare lecture me on the alignment of the cosmos, little insect?"
    koy "你竟敢跟我讲宇宙的运行规律，小虫子？”"

# game/script.rpy:144
translate chinese lie_two_7b1addbd:

    # koy "I am the cosmos. The stars align only when I draw breath."
    koy "我就是宇宙。”只有当我呼吸时，群星才会排列成行。"

# game/script.rpy:152
translate chinese lie_three_0acec964:

    # player "I have hidden the Yellow Sign where no human eye will ever find it, ensuring eternal worship in your absence."
    player "我已将黄牌藏在任何人眼都找不到的地方，确保在你不在的时候，人们会永远敬拜它。”"

# game/script.rpy:154
translate chinese lie_three_b63505d0:

    # koy "Ah... an offering of devotion disguised as a threat."
    koy "啊……一种伪装成威胁的虔诚献祭。”"

# game/script.rpy:155
translate chinese lie_three_27d264ac:

    # koy "To hoard the symbol of our glory so that none may gaze upon it."
    koy "将我们荣耀的象征物藏起来，不让任何人窥视它。”"

# game/script.rpy:157
translate chinese lie_three_6fde25c3:

    # narrator "The entity's glowing eyes soften. A deep, heavy sigh echoes through the room."
    narrator "该实体的发光眼睛柔和了下来。一声沉闷的叹息在房间里回荡。"

# game/script.rpy:161
translate chinese lie_three_9f40032f:

    # koy "Very well, mortal. Keep the Sign safe, and I shall dream of Carcosa's return for a thousand years more."
    koy "很好，凡人。”守护好这道印记，我便能再梦见卡尔克萨的回归，直到千年之后。"

# game/script.rpy:165
translate chinese lie_three_bae86f9a:

    # narrator "The eldritch presence fades into a deep, heavy slumber. The room returns to normal."
    narrator "诡异的存在渐渐消散，陷入了深深的沉睡。房间恢复了原状。"

# game/script.rpy:175
translate chinese lie_three_0b914413:

    # narrator "You have saved humanity from the King in Yellow... for now."
    narrator "你暂时拯救了人类，使他们免遭黄衣之王的毒手。”"

# game/script.rpy:183
translate chinese game_over_awakened_57fc504f:

    # koy "Carcosa awakens."
    koy "卡尔克萨觉醒了。”"

# game/script.rpy:197
translate chinese game_over_awakened_b04ced02:

    # narrator "The barrier between worlds shatters. The corruption bleeds into your operating system."
    narrator "世界之间的屏障破碎了。”这种腐败会渗透到你的操作系统中。"

# game/script.rpy:198
translate chinese game_over_awakened_3f9d77c6:

    # narrator "CONNECTION TERMINATED. SYSTEM COMPROMISED.{w=0.5}.{w=0.5}."
    narrator "连接已终止。SYSTEM COMPROMISED.{w=0.5}.{w=0.5}."

